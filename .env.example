# Copy to .env.local at the repository root. The web app, worker and scripts all read it.

# Supabase (local defaults from `supabase start`, or your hosted project)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Durable runtime (required to run agents)
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Models. With no key the app runs in deterministic mock mode.
ANTHROPIC_API_KEY=
# AI_PROVIDER=anthropic            # or openai
# OPENAI_API_KEY=
# AI_FAST_MODEL=claude-haiku-4-5   # override any model class
# AI_SMART_MODEL=claude-opus-5
# AI_AGENT_MODEL=claude-opus-5
# AI_MOCK=1                        # force mock mode

# Integrations. Without Composio every integration connects in sandbox mode.
COMPOSIO_API_KEY=
# COMPOSIO_AUTH_CONFIGS={"zendesk":"ac_...","stripe":"ac_..."}
# COMPOSIO_TOOLKIT_VERSIONS={"stripe":"20260915_00"}

# Email notifications (optional)
RESEND_API_KEY=
EMAIL_FROM=

# Product analytics (optional)
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
