# Copy to .env.local at the repository root. The web app, worker and scripts all read it.

# Supabase (local defaults from `supabase start`, or your hosted project)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Durable runtime (required to run agents). Project: proj_xytjychoihbtmbxoztql (set in trigger.config.ts)
TRIGGER_SECRET_KEY=

# Models. Gemini is the default provider. With no key the app runs in deterministic mock mode.
GOOGLE_GENERATIVE_AI_API_KEY=
# AI_PROVIDER=google                 # or anthropic, openai
# AI_FAST_MODEL=gemini-3.5-flash-lite
# AI_SMART_MODEL=gemini-3.8-flash
# AI_AGENT_MODEL=gemini-3.8-flash
# ANTHROPIC_API_KEY=                 # with AI_PROVIDER=anthropic
# OPENAI_API_KEY=                    # with AI_PROVIDER=openai
# AI_MOCK=1                          # force mock mode
# CRAWL_ALLOW_PRIVATE=1              # lets the onboarding crawl read localhost (end-to-end tests only; never in production)

# Integrations. Without Composio every integration connects in sandbox mode.
COMPOSIO_API_KEY=
# Site administrators (comma-separated emails) who can create ready-made playbooks at /admin/playbooks.
PLATFORM_ADMIN_EMAILS=
# COMPOSIO_AUTH_CONFIGS={"zendesk":"ac_...","stripe":"ac_..."}
# COMPOSIO_TOOLKIT_VERSIONS={"stripe":"20260915_00"}

# Email notifications (optional)
RESEND_API_KEY=
EMAIL_FROM=

# Product analytics (optional)
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
